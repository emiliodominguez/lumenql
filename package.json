{
	"name": "lumenql",
	"version": "2.1.0",
	"description": "Zero-dependency, typed GraphQL client with caching, request deduplication, retries, subscriptions, streaming and React hooks. Works with the Fetch API across runtimes.",
	"keywords": [
		"graphql",
		"graphql-client",
		"lumenql",
		"gql",
		"client",
		"fetch",
		"cache",
		"lru-cache",
		"dedupe",
		"typescript",
		"typed",
		"zero-dependency",
		"lightweight",
		"persisted-queries",
		"apq",
		"subscriptions",
		"sse",
		"retry",
		"middleware",
		"isomorphic",
		"esm",
		"edge",
		"browser",
		"node",
		"deno",
		"bun",
		"react",
		"react-hooks",
		"suspense",
		"live-queries",
		"defer",
		"stream",
		"file-upload",
		"websocket",
		"graphql-ws",
		"subscriptions-transport",
		"svelte",
		"vue",
		"solid",
		"pagination"
	],
	"author": "Emilio Dominguez",
	"license": "MIT",
	"homepage": "https://github.com/emiliodominguez/lumenql#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/lumenql.git"
	},
	"bugs": {
		"url": "https://github.com/emiliodominguez/lumenql/issues"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			},
			"require": {
				"types": "./dist/react.d.cts",
				"default": "./dist/react.cjs"
			}
		},
		"./ws": {
			"import": {
				"types": "./dist/ws.d.ts",
				"default": "./dist/ws.js"
			},
			"require": {
				"types": "./dist/ws.d.cts",
				"default": "./dist/ws.cjs"
			}
		},
		"./core": {
			"import": {
				"types": "./dist/core.d.ts",
				"default": "./dist/core.js"
			},
			"require": {
				"types": "./dist/core.d.cts",
				"default": "./dist/core.cjs"
			}
		},
		"./upload": {
			"import": {
				"types": "./dist/upload.d.ts",
				"default": "./dist/upload.js"
			},
			"require": {
				"types": "./dist/upload.d.cts",
				"default": "./dist/upload.cjs"
			}
		},
		"./persisted": {
			"import": {
				"types": "./dist/persisted.d.ts",
				"default": "./dist/persisted.js"
			},
			"require": {
				"types": "./dist/persisted.d.cts",
				"default": "./dist/persisted.cjs"
			}
		},
		"./incremental": {
			"import": {
				"types": "./dist/incremental.d.ts",
				"default": "./dist/incremental.js"
			},
			"require": {
				"types": "./dist/incremental.d.cts",
				"default": "./dist/incremental.cjs"
			}
		},
		"./sse": {
			"import": {
				"types": "./dist/sse.d.ts",
				"default": "./dist/sse.js"
			},
			"require": {
				"types": "./dist/sse.d.cts",
				"default": "./dist/sse.cjs"
			}
		},
		"./scalars": {
			"import": {
				"types": "./dist/scalars.d.ts",
				"default": "./dist/scalars.js"
			},
			"require": {
				"types": "./dist/scalars.d.cts",
				"default": "./dist/scalars.cjs"
			}
		},
		"./devtools": {
			"import": {
				"types": "./dist/devtools.d.ts",
				"default": "./dist/devtools.js"
			},
			"require": {
				"types": "./dist/devtools.d.cts",
				"default": "./dist/devtools.cjs"
			}
		},
		"./entities": {
			"import": {
				"types": "./dist/entities.d.ts",
				"default": "./dist/entities.js"
			},
			"require": {
				"types": "./dist/entities.d.cts",
				"default": "./dist/entities.cjs"
			}
		},
		"./svelte": {
			"import": {
				"types": "./dist/svelte.d.ts",
				"default": "./dist/svelte.js"
			},
			"require": {
				"types": "./dist/svelte.d.cts",
				"default": "./dist/svelte.cjs"
			}
		},
		"./vue": {
			"import": {
				"types": "./dist/vue.d.ts",
				"default": "./dist/vue.js"
			},
			"require": {
				"types": "./dist/vue.d.cts",
				"default": "./dist/vue.cjs"
			}
		},
		"./solid": {
			"import": {
				"types": "./dist/solid.d.ts",
				"default": "./dist/solid.js"
			},
			"require": {
				"types": "./dist/solid.d.cts",
				"default": "./dist/solid.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"react": [
				"./dist/react.d.ts"
			],
			"ws": [
				"./dist/ws.d.ts"
			],
			"core": [
				"./dist/core.d.ts"
			],
			"upload": [
				"./dist/upload.d.ts"
			],
			"persisted": [
				"./dist/persisted.d.ts"
			],
			"incremental": [
				"./dist/incremental.d.ts"
			],
			"sse": [
				"./dist/sse.d.ts"
			],
			"scalars": [
				"./dist/scalars.d.ts"
			],
			"devtools": [
				"./dist/devtools.d.ts"
			],
			"entities": [
				"./dist/entities.d.ts"
			],
			"svelte": [
				"./dist/svelte.d.ts"
			],
			"vue": [
				"./dist/vue.d.ts"
			],
			"solid": [
				"./dist/solid.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"demo": "yarn build && node examples/rick-and-morty.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"size": "node scripts/size.js",
		"prepublishOnly": "yarn verify",
		"check:exports": "attw --pack .",
		"verify": "yarn format:check && yarn typecheck && yarn coverage && yarn build && yarn size && yarn check:exports",
		"bench": "esbuild bench/gql.bench.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/bench.mjs && node node_modules/.cache/bench.mjs"
	},
	"peerDependencies": {
		"react": ">=18",
		"vue": ">=3.3",
		"solid-js": ">=1.8"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"vue": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^5.0.4",
		"esbuild": "^0.27.7",
		"happy-dom": "^21.0.1",
		"prettier": "^3.9.10",
		"react": "^19",
		"react-dom": "^19",
		"solid-js": "1.9.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"vue": "3.5.13",
		"ws": "^8.22.0"
	}
}
